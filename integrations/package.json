{
  "name": "@shelf/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider adapters. One isolated module per marketplace; a change to one cannot break another.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@shelf/shared": "*"
  }
}
