# ---------------------------------------------------------------------------
# Shelf — environment configuration example
#
# Copy to .env and fill in. Never commit .env. Never expose any value in this
# file to the frontend bundle except the explicitly prefixed NEXT_PUBLIC_* keys
# at the bottom.
#
# Values left empty cause the related provider capability to report
# "not configured" at runtime. The platform degrades honestly instead of
# fabricating data.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Backend --------------------------------------------------------------
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# Comma separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelf
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Cache / queue --------------------------------------------------------
# Driver: memory | redis.  "memory" is single-process only; use redis for any
# deployment that runs more than one backend or worker instance.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- Sessions & crypto ----------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=shelf_session
SESSION_TTL_HOURS=720
# Secure cookies require HTTPS; keep false only for local http development.
SESSION_COOKIE_SECURE=false

# --- Google OAuth (sign in) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- Admin bootstrap ------------------------------------------------------
# Comma separated e-mail addresses promoted to the admin role on first sign in.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Provider credentials
#
# Each provider block is optional. A provider with missing credentials is
# reported as NOT_CONFIGURED by /api/v1/providers and is excluded from search
# instead of being faked.
# ---------------------------------------------------------------------------

# --- Amazon (Product Advertising API 5.0 + Associates) --------------------
# Requires an approved Associates account and PA-API access keys.
AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Associates tracking id (partner tag) per marketplace, e.g. mytag-20
AMAZON_PARTNER_TAG=
# Host/region pairs are marketplace specific. See docs/providers.md.
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_DEFAULT_COUNTRY=US
# Requests per second permitted by your PA-API quota (starts low, grows with
# shipped revenue). Set conservatively.
AMAZON_RATE_LIMIT_RPS=1
AMAZON_RATE_LIMIT_BURST=1

# --- AliExpress (Open Platform affiliate APIs) ---------------------------
ALIEXPRESS_ENABLED=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync
# Affiliate tracking id configured in the AliExpress affiliate console.
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_DEFAULT_COUNTRY=IL
ALIEXPRESS_RATE_LIMIT_RPS=5
ALIEXPRESS_RATE_LIMIT_BURST=10

# --- Temu (affiliate / partner programme) --------------------------------
# Temu's partner API surface is granted per account. Leave the base URL and
# credentials empty until your own programme contract confirms the endpoints
# and the operations you are licensed to call; the adapter then reports
# VERIFICATION_REQUIRED for every capability rather than guessing.
TEMU_ENABLED=false
TEMU_API_BASE_URL=
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_AFFILIATE_ID=
TEMU_DEFAULT_COUNTRY=IL
TEMU_RATE_LIMIT_RPS=2
TEMU_RATE_LIMIT_BURST=4

# --- Currency rates -------------------------------------------------------
# Provider for FX rates. Driver: static | http
# "static" uses config/fx-rates.json and labels every converted figure with
# the file's as-of date. No driver silently invents a rate.
FX_DRIVER=static
FX_HTTP_URL=
FX_HTTP_API_KEY=
FX_REFRESH_MINUTES=720

# --- Mail (alerts) --------------------------------------------------------
# Driver: console | smtp.  "console" prints to the log and is dev only.
MAIL_DRIVER=console
SMTP_URL=
MAIL_FROM=Shelf <no-reply@example.com>

# --- Demo fixtures --------------------------------------------------------
# When true, providers without credentials serve clearly labelled DEMO
# fixtures so the UI can be developed offline. Every record carries
# dataOrigin=DEMO_FIXTURE and the UI shows a persistent demo banner.
# MUST be false in production; the backend refuses to boot otherwise.
ALLOW_DEMO_FIXTURES=true

# --- Frontend (public, shipped to the browser) ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Shelf
NEXT_PUBLIC_DEFAULT_LOCALE=he
NEXT_PUBLIC_DEFAULT_COUNTRY=IL
NEXT_PUBLIC_DEFAULT_CURRENCY=ILS
